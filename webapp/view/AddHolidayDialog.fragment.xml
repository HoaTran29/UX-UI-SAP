<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    
    <Dialog title="{= ${holidayModel>/isEdit} ? ${i18n>dialogTitleEditHoliday} : ${i18n>dialogTitleAddHoliday} }" contentWidth="460px">
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- ngày nghỉ lễ -->
                <Label text="{i18n>lblHolidayDate}" required="true" class="sapUiTopMarginSmall"/>
                <DatePicker dateValue="{holidayModel>/HolDate}" displayFormat="dd/MM/yyyy" width="100%" editable="{= !${holidayModel>/isEdit} }"/>

                <!-- mô tả ngày lễ -->
                <Label text="{i18n>lblHolidayDesc}" required="true" class="sapUiTopMarginSmall"/>
                <Input value="{holidayModel>/HolDesc}" placeholder="{i18n>phHolidayDesc}"/>

                <!-- mã hệ số lương ngày lễ -->
                <Label text="{i18n>lblHolPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{holidayModel>/HolPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} - {payTypeModel>PayDesc} (x{payTypeModel>RateFactor})" />
                </Select>

            </VBox>
        </content>

        <beginButton>
            <Button text="{i18n>btnSave}" type="Emphasized" press="onSaveHoliday"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>