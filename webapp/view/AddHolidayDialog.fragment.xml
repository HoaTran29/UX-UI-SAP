<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="{= ${holidayModel>/isEdit} ? 'Edit Holiday' : 'Add Holiday' }"
        contentWidth="460px"
        class="holidayDialog">

        <content>
            <VBox class="sapUiMediumMargin">

                <Label text="Holiday Date" required="true" class="sapUiTopMarginSmall"/>
                <DatePicker
                    dateValue="{holidayModel>/HolDate}"
                    displayFormat="dd/MM/yyyy"
                    width="100%"
                    editable="{= !${holidayModel>/isEdit} }"/>

                <Label text="Description" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{holidayModel>/HolDesc}"
                    placeholder="Example: New Year Holiday"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press="onSaveHoliday"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>