<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog 
        id="addOtDialog"
        title="{i18n>dialogTitleScheduleOt}"
        contentWidth="520px">

        <content>
            <VBox class="sapUiSmallMargin">

                <Label
                    text="{i18n>lblAssignBy}"
                    class="sapUiTopMarginSmall"
                    visible="{= !${dialogModel>/isEdit} }"/>

                <SegmentedButton
                    selectedKey="{dialogModel>/AssignMode}"
                    selectionChange=".onAssignModeChange"
                    visible="{= !${dialogModel>/isEdit} }"
                    width="100%">

                    <items>
                        <SegmentedButtonItem key="EMP" text="{i18n>segBtnEmployee}"/>
                        <SegmentedButtonItem key="DEPT" text="{i18n>segBtnDept}"/>
                    </items>
                </SegmentedButton>

                <Label
                    text="{i18n>filterEmpId}"
                    required="true"
                    visible="{= ${dialogModel>/AssignMode} === 'EMP' }"
                    class="sapUiTopMarginSmall"/>

                <Input
                    id="PernrInput"
                    value="{dialogModel>/Pernr}"
                    placeholder="{i18n>phSelectEmpHelp}"
                    editable="{= !${dialogModel>/isEdit} }"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onPernrInputValueHelpRequest"
                    liveChange=".onPernrInputLiveChange"
                    visible="{= ${dialogModel>/AssignMode} === 'EMP' }"/>

                <Text
                    text="{= ${dialogModel>/EmployeeName} ? ${dialogModel>/EmployeeName} + ' - ' + ${dialogModel>/DeptId} : '' }"
                    visible="{= ${dialogModel>/AssignMode} === 'EMP' &amp;&amp; !!${dialogModel>/EmployeeName} }"
                    class="sapUiTinyMarginTop"/>

                <Label
                    text="{i18n>filterDept}"
                    required="true"
                    visible="{= ${dialogModel>/AssignMode} === 'DEPT' }"
                    class="sapUiTopMarginSmall"/>

                <Input
                    id="DeptInput"
                    value="{dialogModel>/DeptId}"
                    placeholder="{i18n>phSelectDeptHelp}"
                    editable="{= !${dialogModel>/isEdit} }"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".onDeptInputValueHelpRequest"
                    liveChange=".onDeptInputLiveChange"
                    visible="{= ${dialogModel>/AssignMode} === 'DEPT' }"/>

                <Text
                    text="{dialogModel>/DeptName}"
                    visible="{= ${dialogModel>/AssignMode} === 'DEPT' &amp;&amp; !!${dialogModel>/DeptName} }"
                    class="sapUiTinyMarginTop"/>

                <Label 
                    text="{i18n>lblSchedulePeriod}"
                    required="true"
                    class="sapUiTopMarginSmall"
                    visible="{= !${dialogModel>/isEdit} }"/>

                <DateRangeSelection 
                    dateValue="{dialogModel>/StartDate}"
                    secondDateValue="{dialogModel>/EndDate}"
                    displayFormat="dd/MM/yyyy"
                    visible="{= !${dialogModel>/isEdit} }"/>

                <Label 
                    text="{i18n>lblWorkDate}"
                    required="true"
                    class="sapUiTopMarginSmall"
                    visible="{dialogModel>/isEdit}"/>

                <DatePicker 
                    dateValue="{dialogModel>/PlanDate}"
                    displayFormat="dd/MM/yyyy"
                    editable="false"
                    visible="{dialogModel>/isEdit}"/>

                <Label text="{i18n>lblShift}" required="true" class="sapUiTopMarginSmall"/>

                <Select 
                    id="shiftSelect"
                    selectedKey="{dialogModel>/ShiftId}"
                    items="{shiftLookupModel>/shifts}"
                    width="100%">

                    <core:Item 
                        key="{shiftLookupModel>ShiftId}"
                        text="{shiftLookupModel>ShiftText}" />
                </Select>

                <Label text="{i18n>lblOtHours}" class="sapUiTopMarginSmall"/>

                <Input 
                    value="{dialogModel>/OtHours}"
                    type="Number"
                    placeholder="{i18n>phEnterOtHours}" />

            </VBox>
        </content>

        <beginButton>
            <Button 
                text="{i18n>btnSaveData}"
                type="Emphasized"
                press=".onSaveOtPlan" />
        </beginButton>

        <endButton>
            <Button 
                text="{i18n>btnClose}"
                press=".onCloseAddDialog" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>