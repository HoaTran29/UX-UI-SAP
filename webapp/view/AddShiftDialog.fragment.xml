<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="{= ${shiftModel>/isEdit} ? ${i18n>dialogTitleEditShift} : ${i18n>dialogTitleAddShift} }"
        contentWidth="520px"
        class="shiftConfigDialog">

        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="{i18n>lblShiftId}" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/ShiftId}"
                    placeholder="{i18n>phShiftId}"
                    maxLength="20"
                    editable="{= !${shiftModel>/isEdit} }"/>

                <Label text="{i18n>lblStdHours}" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/StdHours}"
                    type="Number"
                    placeholder="{i18n>phStdHours}"/>

                <Label text="{i18n>lblStartTime}" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker
                    value="{shiftModel>/TimeIn}"
                    valueFormat="HHmmss"
                    displayFormat="HH:mm"
                    width="100%"
                    placeholder="{i18n>phStartTime}"/>

                <Label text="{i18n>lblEndTime}" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker
                    value="{shiftModel>/TimeOut}"
                    valueFormat="HHmmss"
                    displayFormat="HH:mm"
                    width="100%"
                    placeholder="{i18n>phEndTime}"/>

                <Label text="{i18n>lblNextDay}" class="sapUiTopMarginSmall"/>
                <Switch
                    state="{shiftModel>/NextDayBool}"
                    customTextOn="{i18n>switchYes}"
                    customTextOff="{i18n>switchNo}"/>

                <Label text="{i18n>lblGraceMins}" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/GraceMins}"
                    type="Number"
                    placeholder="{i18n>phGraceMins}"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                text="{i18n>btnSave}"
                type="Emphasized"
                press="onSaveShift"/>
        </beginButton>

        <endButton>
            <Button
                text="{i18n>btnCancel}"
                press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>