<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="{= ${shiftModel>/isEdit} ? 'Edit Work Shift' : 'Create Work Shift' }"
        contentWidth="520px"
        class="shiftConfigDialog">

        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="Shift ID" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/ShiftId}"
                    placeholder="Example: CA_01"
                    maxLength="20"
                    editable="{= !${shiftModel>/isEdit} }"/>

                <Label text="Standard Hours" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/StdHours}"
                    type="Number"
                    placeholder="Example: 8"/>

                <Label text="Start Time" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker
                    value="{shiftModel>/TimeIn}"
                    valueFormat="HHmmss"
                    displayFormat="HH:mm"
                    width="100%"
                    placeholder="Select start time"/>

                <Label text="End Time" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker
                    value="{shiftModel>/TimeOut}"
                    valueFormat="HHmmss"
                    displayFormat="HH:mm"
                    width="100%"
                    placeholder="Select end time"/>

                <Label text="Overnight Shift" class="sapUiTopMarginSmall"/>
                <Switch
                    state="{shiftModel>/NextDayBool}"
                    customTextOn="Yes"
                    customTextOff="No"/>

                <Label text="Allowed Late Minutes" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/GraceMins}"
                    type="Number"
                    placeholder="Example: 0"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press="onSaveShift"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>