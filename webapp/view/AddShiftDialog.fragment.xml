<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- Shift Configuration Add/Edit Dialog Fragment -->
    <Dialog 
        title="{= ${shiftModel>/isEdit} ? ${i18n>dialogTitleEditShift} : ${i18n>dialogTitleAddShift} }"
        contentWidth="520px"
        class="shiftConfigDialog">

        <!-- Dialog Content Container -->
        <content>
            <VBox class="sapUiMediumMargin">
                
                <!-- Shift ID Field -->
                <Label text="{i18n>lblShiftId}" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/ShiftId}"
                    placeholder="{i18n>phShiftId}"
                    maxLength="20"
                    editable="{= !${shiftModel>/isEdit} }"/>

                <!-- Standard Working Hours Field -->
                <Label text="{i18n>lblStdHours}" required="true" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/StdHours}"
                    type="Number"
                    placeholder="{i18n>phStdHours}"/>

                <!-- Shift Start Time (Time In) -->
                <Label text="{i18n>lblStartTime}" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker
                    value="{shiftModel>/TimeIn}"
                    valueFormat="HHmmss"
                    displayFormat="HH:mm"
                    width="100%"
                    placeholder="{i18n>phStartTime}"/>

                <!-- Shift End Time (Time Out) -->
                <Label text="{i18n>lblEndTime}" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker
                    value="{shiftModel>/TimeOut}"
                    valueFormat="HHmmss"
                    displayFormat="HH:mm"
                    width="100%"
                    placeholder="{i18n>phEndTime}"/>

                <!-- Next Day Indicator Switch -->
                <Label text="{i18n>lblNextDay}" class="sapUiTopMarginSmall"/>
                <Switch
                    state="{shiftModel>/NextDayBool}"
                    customTextOn="{i18n>switchYes}"
                    customTextOff="{i18n>switchNo}"/>

                <Label text="{i18n>lblStdPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{shiftModel>/StdPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} (x{payTypeModel>RateFactor})" />
                </Select>

                <Label text="{i18n>lblWeekendPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{shiftModel>/WeekendPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} (x{payTypeModel>RateFactor})" />
                </Select>

                <Label text="{i18n>lblOtPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{shiftModel>/OtPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} (x{payTypeModel>RateFactor})" />
                </Select>

                <!-- Grace Period Minutes Field -->
                <Label text="{i18n>lblGraceMins}" class="sapUiTopMarginSmall"/>
                <Input
                    value="{shiftModel>/GraceMins}"
                    type="Number"
                    placeholder="{i18n>phGraceMins}"/>

            </VBox>
        </content>

        <!-- Dialog Action Buttons: Save & Cancel -->
        <beginButton>
            <Button
                text="{i18n>btnSave}"
                type="Emphasized"
                press="onSaveShift"/>
        </beginButton>

        <endButton>
            <Button
                text="{i18n>btnCancel}"
                press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>