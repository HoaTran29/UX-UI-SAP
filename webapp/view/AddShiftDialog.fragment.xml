<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <Dialog title="{= ${shiftModel>/isEdit} ? ${i18n>dialogTitleEditShift} : ${i18n>dialogTitleAddShift} }" contentWidth="520px">
        <content>
            <VBox class="sapUiMediumMargin">
                
                <!-- mã ca làm việc -->
                <Label text="{i18n>lblShiftId}" required="true" class="sapUiTopMarginSmall"/>
                <Input value="{shiftModel>/ShiftId}" placeholder="{i18n>phShiftId}" maxLength="20" editable="{= !${shiftModel>/isEdit} }"/>

                <!-- giờ công chuẩn -->
                <Label text="{i18n>lblStdHours}" required="true" class="sapUiTopMarginSmall"/>
                <Input value="{shiftModel>/StdHours}" type="Number" placeholder="{i18n>phStdHours}"/>

                <!-- giờ bắt đầu ca -->
                <Label text="{i18n>lblStartTime}" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker value="{shiftModel>/TimeIn}" valueFormat="HHmmss" displayFormat="HH:mm" width="100%" placeholder="{i18n>phStartTime}"/>

                <!-- giờ kết thúc ca -->
                <Label text="{i18n>lblEndTime}" required="true" class="sapUiTopMarginSmall"/>
                <TimePicker value="{shiftModel>/TimeOut}" valueFormat="HHmmss" displayFormat="HH:mm" width="100%" placeholder="{i18n>phEndTime}"/>

                <!-- cờ đánh dấu ca qua đêm -->
                <Label text="{i18n>lblNextDay}" class="sapUiTopMarginSmall"/>
                <Switch state="{shiftModel>/NextDayBool}" customTextOn="{i18n>switchYes}" customTextOff="{i18n>switchNo}"/>

                <!-- mã hệ số lương ngày thường -->
                <Label text="{i18n>lblStdPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{shiftModel>/StdPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} (x{payTypeModel>RateFactor})" />
                </Select>

                <!-- mã hệ số lương cuối tuần -->
                <Label text="{i18n>lblWeekendPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{shiftModel>/WeekendPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} (x{payTypeModel>RateFactor})" />
                </Select>

                <!-- mã hệ số lương ot -->
                <Label text="{i18n>lblOtPayCode}" required="true" class="sapUiTopMarginSmall"/>
                <Select selectedKey="{shiftModel>/OtPayCode}" items="{payTypeModel>/payTypes}" width="100%">
                    <core:Item key="{payTypeModel>PayCode}" text="{payTypeModel>PayCode} (x{payTypeModel>RateFactor})" />
                </Select>

                <!-- số phút có thể đi trễ -->
                <Label text="{i18n>lblGraceMins}" class="sapUiTopMarginSmall"/>
                <Input value="{shiftModel>/GraceMins}" type="Number" placeholder="{i18n>phGraceMins}"/>

            </VBox>
        </content>

        <beginButton>
            <Button text="{i18n>btnSave}" type="Emphasized" press="onSaveShift"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>