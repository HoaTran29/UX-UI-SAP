<mvc:View
    controllerName="com.app.zu26g13.app.controller.App"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">
    
    <Shell appWidthLimited="false"> 
        <App>
            <tnt:ToolPage id="toolPage">
                
                <!-- header thanh công cụ ở trên cùng -->
                <tnt:header>
                    <tnt:ToolHeader>
                        <Button icon="sap-icon://menu2" type="Transparent" press=".onCollapseExpandPress" />
                        <Title text="{i18n>appTitle}" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://course-book" text="{i18n>btnPolicyText}" type="Transparent" tooltip="{i18n>btnPolicyTooltip}" press=".onOpenPolicy" />
                    </tnt:ToolHeader>
                </tnt:header>

                <!-- menu điều hướng bên trái -->
                <tnt:sideContent>
                    <tnt:SideNavigation id="sideNavigation" itemSelect=".onItemSelect">
                        <tnt:item>
                            <tnt:NavigationList>
                                <tnt:NavigationListItem text="{i18n>menuDashboard}" key="dashboard" />
                                <tnt:NavigationListItem text="{i18n>menuTimesheet}" key="timesheet" />
                                <tnt:NavigationListItem text="{i18n>menuMonthlyReport}" key="monthlyReport" />
                                <tnt:NavigationListItem text="{i18n>menuDispute}" key="dispute" />
                            </tnt:NavigationList>
                        </tnt:item>
                        
                        <tnt:fixedItem>
                            <tnt:NavigationList>
                                <tnt:NavigationListItem text="{i18n>menuMasterData}" icon="sap-icon://action-settings" expanded="false">
                                    <tnt:NavigationListItem text="{i18n>menuEmployees}" key="employeeConfig" />
                                    <tnt:NavigationListItem text="{i18n>menuSchedules}" key="schedule" />
                                    <tnt:NavigationListItem text="{i18n>menuHolidays}" key="holiday" />
                                    <tnt:NavigationListItem text="{i18n>menuShifts}" key="shiftConfig"/>
                                    <tnt:NavigationListItem text="{i18n>menuPayRates}" key="payTypeConfig" />
                                </tnt:NavigationListItem>
                            </tnt:NavigationList>
                        </tnt:fixedItem>
                    </tnt:SideNavigation>
                </tnt:sideContent>

                <!-- khung chứa nội dung các trang con -->
                <tnt:mainContents>
                    <NavContainer id="pageContainer"></NavContainer>
                </tnt:mainContents>

            </tnt:ToolPage>
        </App>
    </Shell>
</mvc:View>