<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
    <Dialog id="approveDialog" title="{i18n>dialogTitleApprove}" contentWidth="400px">
        <content>
            <layout:VerticalLayout class="sapUiContentPadding" width="100%">
                
                <!-- giờ in -->
                <Label text="{i18n>lblInTimeMgr}" design="Bold" visible="{= ${RequestType} !== 'REMOVE_WAR' }"/>
                <TimePicker value="{ path: 'NewActIn', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern: 'HH:mm:ss' } }" width="100%" visible="{= ${RequestType} !== 'REMOVE_WAR' }"/>
                
                <!-- giờ out     -->
                <Label text="{i18n>lblOutTimeMgr}" design="Bold" class="sapUiSmallMarginTop" visible="{= ${RequestType} !== 'REMOVE_WAR' }" />
                <TimePicker value="{ path: 'NewActOut', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern: 'HH:mm:ss' } }" width="100%" visible="{= ${RequestType} !== 'REMOVE_WAR' }"/>
                
                <!-- lý do của nhân viên -->
                <Label text="{i18n>lblEmpReason}" class="sapUiSmallMarginTop" design="Bold"/>
                <Text text="{Reason}" class="sapUiTinyMarginTop"/>
                
                <!-- ot hours -->
                <Label text="{i18n>colOtHoursEdit}" class="sapUiSmallMarginTop" design="Bold" visible="{= ${RequestType} === 'OVERTIME' }"/>
                <StepInput value="{ path: 'OtHours', type: 'sap.ui.model.odata.type.Decimal' }" min="0" max="12" step="0.5" displayValuePrecision="1" visible="{= ${RequestType} === 'OVERTIME' }" width="100%"/>

                <!-- ghi chú -->
                <Label text="{i18n>lblManagerNote}" class="sapUiSmallMarginTop" design="Bold" />
                <TextArea id="approveNoteInput" value="{ApproverComment}" width="100%" rows="4" placeholder="{i18n>phApproveReason}" maxLength="255"/>
            </layout:VerticalLayout>
        </content>
        
        <beginButton>
            <Button type="Accept" text="{i18n>btnSaveApprove}" press=".onConfirmApprove" />
        </beginButton>
        <endButton>
            <Button text="{i18n>btnClose}" press=".onCancelDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>