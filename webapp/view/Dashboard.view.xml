<mvc:View
    controllerName="com.app.zu26g13.app.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <Page id="pageDashboard" showHeader="false">
        
        <VBox class="sapUiSmallMargin">
            
            <layout:Grid id="gridKPI" defaultSpan="XL3 L3 M6 S12" class="sapUiBottomMargin">
                <GenericTile id="tileEmp" class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="{i18n>tileTotalEmp}" subheader="{i18n>tileTotalEmpSub}" 
                frameType="OneByOne" press=".onNavToEmployee">
                    <TileContent id="tcEmp">
                        <NumericContent id="ncEmp" value="{kpi>/totalEmp}" icon="sap-icon://employee" valueColor="Good"/>
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileOT" class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="{i18n>tileTotalOt}" subheader="{i18n>tileTotalOtSub}" 
                frameType="OneByOne" press=".onNavToMonthlyReport">
                    <TileContent id="tcOT">
                        <NumericContent id="ncOT" value="{kpi>/totalOT}" icon="sap-icon://history" valueColor="Critical"/>
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileReport" class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="{i18n>tileReport}" subheader="{i18n>tileReportSub}" frameType="OneByOne" press=".onGoToDispute">
                    <TileContent id="tcReport">
                        <NumericContent id="ncReport" value="{kpi>/pendingDisputes}" icon="sap-icon://alert" valueColor="Error"/>
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileSchedule" class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="{i18n>tileSchedule}" subheader="{i18n>tileScheduleSub}" frameType="OneByOne" press=".onNavToSchedule">
                    <TileContent id="tcSchedule">
                        <ImageContent src="sap-icon://calendar" />
                    </TileContent>
                </GenericTile>
            </layout:Grid>

            <Title id="titleTimesheet" text="{i18n>titleTimesheet}" titleStyle="H3" class="sapUiMediumMarginBottom sapUiMediumMarginTop"/>
            
            <fb:FilterBar id="filterBar" search=".onSearch" clear=".onClear" showClearOnFB="true" class="sapUiBottomMargin">
                <fb:filterGroupItems>
                    
                    <!-- 1. ĐÃ SỬA: Bật Value Help cho ô Nhân viên -->
                    <fb:FilterGroupItem groupName="G1" name="Pernr" label="{i18n>filterEmpId}" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="fltEmp" 
                                   placeholder="{i18n>phEnterEmpId}" 
                                   showValueHelp="true" 
                                   valueHelpRequest=".onEmpValueHelpRequest" />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <!-- 2. ĐÃ SỬA: Đổi ComboBox thành Input và bật Value Help cho ô Phòng ban -->
                    <fb:FilterGroupItem groupName="G1" name="Dept" label="{i18n>filterDept}" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="fltDept" 
                                   placeholder="{i18n>phSelectDeptFilter}" 
                                   showValueHelp="true" 
                                   valueHelpRequest=".onDeptValueHelpRequest" />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem groupName="G1" name="Date" label="{i18n>filterDate}" visibleInFilterBar="true">
                        <fb:control>
                            <DatePicker id="fltDate" displayFormat="dd/MM/yyyy" placeholder="{i18n>phSelectDate}" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <Table id="timesheetTable"
                   items="{
                       path: '/Timesheet',
                       sorter: [
                           { path: 'WorkDate', descending: false },
                           { path: 'DeptId', descending: false }
                       ]
                   }"
                   growing="true"
                   growingThreshold="10"
                   class="sapUiElevationCore3">
                
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>titleWorkDetails}" level="H4"/>
                        <ToolbarSpacer/>
                        <Button id="btnExport" icon="sap-icon://excel-attachment" text="{i18n>btnExportExcel}" type="Success" press=".onExportExcel" tooltip="{i18n>ttExportExcel}"/>
                    </OverflowToolbar>
                </headerToolbar>
                
                <columns>
                    <Column id="colEmp"><Text id="txtColEmp" text="{i18n>colEmpShift}" /></Column>
                    <Column id="colDept"><Text id="txtColDept" text="{i18n>colDept}" /></Column>
                    <Column id="colDate"><Text id="txtColDate" text="{i18n>filterDate}" /></Column>
                    <Column id="colTime" demandPopin="true" minScreenWidth="Tablet"><Text id="txtColTime" text="{i18n>colTimeInOut}" /></Column>
                    <Column id="colStdHours" hAlign="Center"><Text id="txtColStdHours" text="{i18n>colStdHours}" /></Column>
                    <Column id="colActHours" hAlign="Center"><Text id="txtColActHours" text="{i18n>colActHours}" /></Column>
                    <Column id="colOtHours" hAlign="Center"><Text id="txtColOtHours" text="{i18n>colOtHours}" /></Column>
                    <Column id="colStatus" hAlign="Center"><Text id="txtColStatus" text="{i18n>colStatus}" /></Column>
                </columns>

                <items>
                    <ColumnListItem id="cliTimesheet" type="Active">
                        <cells>
                            <ObjectIdentifier id="objIdEmp" title="{Pernr}" text="Shift {ShiftId}"/>

                            <Text id="txtCellDept" text="{= ${deptLookup>/}[${DeptId}] ? ${deptLookup>/}[${DeptId}] : ${DeptId} }" />
                            <Text id="txtCellDate" text="{ path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" />
                            
                            <Text id="txtCellTime" text="{ path: 'ActIn', type: 'sap.ui.model.odata.type.Time' } - { path: 'ActOut', type: 'sap.ui.model.odata.type.Time' }" />
                            
                            <ObjectNumber id="objNumStd" number="{WorkHours}" />

                            <ObjectNumber id="objNumAct"
                                number="{TotHours}" 
                                state="{= parseFloat(${TotHours}) >= parseFloat(${WorkHours}) ? 'Success' : 'Error' }"/>

                            <ObjectNumber id="objNumOt"
                                number="{OtHours}" 
                                state="Warning"
                                visible="{= parseFloat(${OtHours}) > 0 }"/>
                            
                            <ObjectStatus id="objStatStatus"
                                text="{Status}" 
                                inverted="true"
                                state="{= ${Status} === 'APPROVED' ? 'Success' : 
                                         (${Status} === 'PENDING' ? 'Warning' : 
                                         (${Status} === 'LATE_IN' || ${Status} === 'EARLY_OUT' ? 'Error' : 
                                         (${Status} === 'ON_TIME' ? 'Indication05' : 'None'))) }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            
        </VBox>
    </Page>
</mvc:View>