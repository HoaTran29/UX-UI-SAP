<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    
    <ResponsivePopover placement="Bottom" contentWidth="350px" contentHeight="400px" title="{i18n>dialogTitleSelectDept}">
        
        <!-- thanh tìm kiếm -->
        <subHeader>
            <Toolbar>
                <SearchField placeholder="{i18n>phSearchSelectDept}" search=".onDeptValueHelpSearch" liveChange=".onDeptValueHelpSearch" width="100%" />
            </Toolbar>
        </subHeader>
        
        <!-- danh sách phòng ban đổ từ odata -->
        <content>
            <List id="deptValueHelpList" items="{/Department}" mode="SingleSelectMaster" selectionChange=".onDeptValueHelpConfirm" noDataText="{i18n>noDataDept}">
                <StandardListItem title="{DeptName}" description="{DeptId}" type="Active" />
            </List>
        </content>
        
        <endButton>
            <Button text="{i18n>btnClose}" press=".onDeptValueHelpCancel" />
        </endButton>
        
    </ResponsivePopover>

</core:FragmentDefinition>