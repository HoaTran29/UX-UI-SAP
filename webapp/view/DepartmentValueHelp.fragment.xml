<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <ResponsivePopover
        id="deptValueHelpDialog"
        title="{i18n>dialogTitleSelectDept}"
        placement="Bottom"
        contentWidth="350px"
        contentHeight="400px">
        
        <endButton>
            <Button text="Close" press=".onDeptValueHelpCancel" />
        </endButton>
        
        <subHeader>
            <Toolbar>
                <SearchField placeholder="Tìm kiếm..." search=".onDeptValueHelpSearch" liveChange=".onDeptValueHelpSearch" width="100%" />
            </Toolbar>
        </subHeader>
        
        <content>
            <List
                id="deptValueHelpList"
                items="{/Department}"
                mode="SingleSelectMaster"
                selectionChange=".onDeptValueHelpConfirm"
                noDataText="{i18n>noDataDept}">
                
                <StandardListItem
                    title="{DeptName}"
                    description="{DeptId}"
                    type="Active" />
            </List>
        </content>
        
    </ResponsivePopover>
</core:FragmentDefinition>