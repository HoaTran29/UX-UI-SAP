<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    
    <!-- Department Value Help Responsive Popover Fragment -->
    <ResponsivePopover
        id="deptValueHelpDialog"
        title="{i18n>dialogTitleSelectDept}"
        placement="Bottom"
        contentWidth="350px"
        contentHeight="400px">
        
        <!-- Popover Footer Action Button -->
        <endButton>
            <Button text="{i18n>btnClose}" press=".onDeptValueHelpCancel" />
        </endButton>
        
        <!-- Search SubHeader Section -->
        <subHeader>
            <Toolbar>
                <SearchField placeholder="{i18n>phSearchSelectDept}" search=".onDeptValueHelpSearch" liveChange=".onDeptValueHelpSearch" width="100%" />
            </Toolbar>
        </subHeader>
        
        <!-- Popover Content Area: Department List Selection -->
        <content>
            <List
                id="deptValueHelpList"
                items="{/Department}"
                mode="SingleSelectMaster"
                selectionChange=".onDeptValueHelpConfirm"
                noDataText="{i18n>noDataDept}">
                
                <!-- Department Item Template -->
                <StandardListItem
                    title="{DeptName}"
                    description="{DeptId}"
                    type="Active" />
            </List>
        </content>
        
    </ResponsivePopover>
</core:FragmentDefinition>