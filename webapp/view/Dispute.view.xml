<mvc:View
    controllerName="com.app.zu26g13.app.controller.Dispute"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">

    <f:DynamicPage class="sapUiContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>titleApproveReport}" level="H1"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- bảng danh sách khiếu nại chờ duyệt -->
        <f:content>
            <Table id="disputeTable" items="{ path: '/Dispute', sorter: { path: 'CreatedAt', descending: true } }" growing="true" class="sapUiElevationCore3">
                <columns hAlign="Center">
                    <Column width="150px"><Text text="{i18n>colEmpId}" /></Column>
                    <Column><Text text="{i18n>colReqType}" /></Column>
                    <Column><Text text="{i18n>colDate}" /></Column>
                    <Column><Text text="{i18n>colTimeEdit}" /></Column>
                    <Column width="150px"><Text text="{i18n>colOtHoursEdit}" /></Column>
                    <Column width="15%"><Text text="{i18n>colReason}" /></Column>
                    <Column width="120px"><Text text="{i18n>colStatus}" /></Column>
                    <Column><Text text="{i18n>colAction}" /></Column>
                </columns>
                
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{Pernr}" text="Shift {ShiftId}"/>
                            <Text text="{RequestType}" />
                            <Text text="{ path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" />
                            <Text text="{= (${RequestType} === 'LEAVE' || ${RequestType} === 'REMOVE_WAR') ? 'N/A' : ${path: 'NewActIn', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern: 'HH:mm:ss' }} + ' - ' + ${path: 'NewActOut', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern: 'HH:mm:ss' }} }" />
                            <ObjectNumber number="{OtHours}" state="Warning" visible="{= parseFloat(${OtHours}) > 0 }" />
                            <Text text="{Reason}" wrapping="true" />
                            <ObjectStatus text="{Status}" state="{= ${Status} === 'APPROVED' ? 'Success' : (${Status} === 'REJECTED' ? 'Error' : 'Warning') }" />

                            <!-- nút duyệt từ chối (chỉ hiện khi pending) -->
                            <HBox justifyContent="Center" visible="{= ${Status} === 'PENDING' }">
                                <Button type="Accept" text="{i18n>btnApprove}" class="sapUiTinyMarginEnd" press=".onOpenDialog"/>
                                <Button type="Reject" text="{i18n>btnReject}" press=".onOpenRejectDialog"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>