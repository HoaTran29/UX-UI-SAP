<mvc:View
    controllerName="com.app.zu26g13.app.controller.Dispute"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="pageDispute" showHeader="false" class="sapUiContentPadding">
        
        <dependents>
            <Dialog id="approveDialog" title="{i18n>dialogTitleApprove}" contentWidth="400px">
                <content>
                    <layout:VerticalLayout class="sapUiContentPadding" width="100%">
                        <Label text="{i18n>lblInTimeMgr}" design="Bold"/>
                        <TimePicker id="tpNewIn" value="{ path: 'NewActIn', type: 'sap.ui.model.odata.type.Time' }" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss" width="100%"/>
                        
                        <Label text="{i18n>lblOutTimeMgr}" design="Bold" class="sapUiSmallMarginTop" />
                        <TimePicker id="tpNewOut" value="{ path: 'NewActOut', type: 'sap.ui.model.odata.type.Time' }" valueFormat="HH:mm:ss" displayFormat="HH:mm:ss" width="100%"/>
                        
                        <Label text="{i18n>lblEmpReason}" class="sapUiSmallMarginTop" design="Bold"/>
                        <Text text="{Reason}" class="sapUiTinyMarginTop"/>
                    </layout:VerticalLayout>
                </content>
                <beginButton>
                    <Button type="Accept" text="{i18n>btnSaveApprove}" press=".onConfirmApprove" />
                </beginButton>
                <endButton>
                    <Button text="{i18n>btnClose}" press=".onCancelDialog" />
                </endButton>
            </Dialog>

            <Dialog id="rejectDialog" title="{i18n>dialogTitleReject}" contentWidth="400px">
                <content>
                    <layout:VerticalLayout class="sapUiContentPadding" width="100%">
                        <Label text="{i18n>lblRejectReason}" design="Bold"/>
                        <TextArea id="rejectNote" value="{ApproverComment}" width="100%" rows="4" placeholder="{i18n>phRejectReason}"/>
                    </layout:VerticalLayout>
                </content>
                <beginButton>
                    <Button type="Reject" text="{i18n>btnConfirmReject}" press=".onConfirmReject" />
                </beginButton>
                <endButton>
                    <Button text="{i18n>btnCancel}" press=".onCancelReject" />
                </endButton>
            </Dialog>
        </dependents>

        <Title id="titleDispute" text="{i18n>titleApproveReport}" titleStyle="H2" class="sapUiMediumMarginBottom sapUiMediumMarginTop"/>

        <Table id="disputeTable"
               items="{
                   path: '/Dispute',
                   filters: [{ path: 'Status', operator: 'EQ', value1: 'PENDING' }]
               }"
               growing="true"
               class="sapUiElevationCore3">
            <columns>
                <Column id="colEmpId"><Text id="txtEmpId" text="{i18n>colEmpId}" /></Column>
                <Column id="colReqType"><Text id="txtReqType" text="{i18n>colReqType}" /></Column>
                <Column id="colWorkDate"><Text id="txtWorkDate" text="{i18n>colDate}" /></Column>
                <Column id="colTimeEdit"><Text id="txtTimeEdit" text="{i18n>colTimeEdit}" /></Column>
                <Column id="colReason" width="20%"><Text id="txtReason" text="{i18n>colReason}" /></Column>
                <Column id="colAction" hAlign="Center"><Text id="txtAction" text="{i18n>colAction}" /></Column>
            </columns>
            <items>
                <ColumnListItem id="cliDisputeItem">
                    <cells>
                        <ObjectIdentifier id="objEmpId" title="{Pernr}" />
                        <Text id="txtReqTypeVal" text="{RequestType}" />
                        <Text id="txtWorkDateVal" text="{ path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" />
                        <Text id="txtTimeEditVal" text="{ path: 'NewActIn', type: 'sap.ui.model.odata.type.Time' } - { path: 'NewActOut', type: 'sap.ui.model.odata.type.Time' }" />
                        <Text id="txtReasonVal" text="{Reason}" wrapping="true" />
                        
                        <HBox id="hboxActions" justifyContent="Center">
                            <Button id="btnReview" icon="sap-icon://edit" type="Emphasized" text="{i18n>btnProcess}" class="sapUiTinyMarginEnd" press=".onOpenDialog"/>
                            <Button id="btnReject" icon="sap-icon://decline" type="Reject" text="{i18n>btnReject}" press=".onOpenRejectDialog"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>