<mvc:View
    controllerName="com.app.zu26g13.app.controller.Dispute"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="pageDispute" showHeader="false" class="sapUiContentPadding">

        <Title id="titleDispute" text="{i18n>titleApproveReport}" titleStyle="H2" class="sapUiMediumMarginBottom sapUiMediumMarginTop"/>

        <Table id="disputeTable"
               items="{
                   path: '/Dispute',
                   filters: [{ path: 'Status', operator: 'EQ', value1: 'PENDING' }]
               }"
               growing="true"
               class="sapUiElevationCore3">
            <columns>
                <Column id="colEmpId"><Text id="txtEmpId" text="{i18n>colEmpId}" /></Column>
                <Column id="colReqType"><Text id="txtReqType" text="{i18n>colReqType}" /></Column>
                <Column id="colWorkDate"><Text id="txtWorkDate" text="{i18n>colDate}" /></Column>
                <Column id="colTimeEdit"><Text id="txtTimeEdit" text="{i18n>colTimeEdit}" /></Column>
                <Column id="colReason" width="20%"><Text id="txtReason" text="{i18n>colReason}" /></Column>
                <Column id="colAction" hAlign="Center"><Text id="txtAction" text="{i18n>colAction}" /></Column>
            </columns>
            <items>
                <ColumnListItem id="cliDisputeItem">
                    <cells>
                        <ObjectIdentifier id="objEmpId" title="{Pernr}" />
                        <Text id="txtReqTypeVal" text="{RequestType}" />
                        <Text id="txtWorkDateVal" text="{ path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" />
                        <Text id="txtTimeEditVal" text="{ path: 'NewActIn', type: 'sap.ui.model.odata.type.Time' } - { path: 'NewActOut', type: 'sap.ui.model.odata.type.Time' }" />
                        <Text id="txtReasonVal" text="{Reason}" wrapping="true" />
                        
                        <HBox id="hboxActions" justifyContent="Center">
                            <Button id="btnReview" type="Accept" text="{i18n>btnApprove}" class="sapUiTinyMarginEnd" press=".onOpenDialog"/>
                            <Button id="btnReject" type="Reject" text="{i18n>btnReject}" press=".onOpenRejectDialog"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>