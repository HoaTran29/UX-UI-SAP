<mvc:View
    controllerName="com.app.zu26g13.app.controller.Dispute"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout">

    <!-- Dispute Management Dynamic Page Layout -->
    <f:DynamicPage id="dynamicPageDispute" class="sapUiContentPadding">

        <!-- Page Header Title Section -->
        <f:title>
            <f:DynamicPageTitle id="pageTitleDispute">
                <f:heading>
                    <Title id="titleDispute" text="{i18n>titleApproveReport}" level="H1"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Page Main Content Area (Dispute Reports Table) -->
        <f:content>
            <Table id="disputeTable"
                   items="{
                       path: '/Dispute',
                       sorter: { path: 'CreatedAt', descending: true }
                   }"
                   growing="true"
                   class="sapUiElevationCore3">
                
                <!-- Table Columns Definition -->
                <columns hAlign="Center">
                    <Column id="colEmpId" width="150px"><Text id="txtEmpId" text="{i18n>colEmpId}" /></Column>
                    <Column id="colShiftId" width="125px"><Text id="txtShiftId" text="{i18n>colShift}" /></Column>
                    <Column id="colReqType"><Text id="txtReqType" text="{i18n>colReqType}" /></Column>
                    <Column id="colWorkDate"><Text id="txtWorkDate" text="{i18n>colDate}" /></Column>
                    <Column id="colTimeEdit"><Text id="txtTimeEdit" text="{i18n>colTimeEdit}" /></Column>
                    <Column id="colOtHours" width="150px"><Text id="txtOtHours" text="{i18n>colOtHoursEdit}" /></Column>
                    <Column id="colReason" width="15%"><Text id="txtReason" text="{i18n>colReason}" /></Column>
                    <Column id="colStatus" width="120px"><Text id="txtStatus" text="{i18n>colStatus}" /></Column>
                    
                    <Column id="colAction"><Text id="txtAction" text="{i18n>colAction}" /></Column>
                </columns>
                
                <!-- Table Rows Binding Template -->
                <items>
                    <ColumnListItem id="cliDisputeItem">
                        <cells>
                            <ObjectIdentifier id="objEmpId" title="{Pernr}" />
                            <Text id="txtShiftIdVal" text="{ShiftId}" />
                            <Text id="txtReqTypeVal" text="{RequestType}" />
                            <Text id="txtWorkDateVal" text="{ path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" />
                            <Text id="txtTimeEditVal" text="{ path: 'NewActIn', type: 'sap.ui.model.odata.type.Time' } - { path: 'NewActOut', type: 'sap.ui.model.odata.type.Time' }" />
                            <ObjectNumber number="{OtHours}" state="Warning" visible="{= parseFloat(${OtHours}) > 0 }" />
                            <Text id="txtReasonVal" text="{Reason}" wrapping="true" />
                            <ObjectStatus id="objStatusVal" text="{Status}" state="{= ${Status} === 'APPROVED' ? 'Success' : (${Status} === 'REJECTED' ? 'Error' : 'Warning') }" />

                            <HBox id="hboxActions" justifyContent="Center" visible="{= ${Status} === 'PENDING' }">
                                <Button id="btnReview" type="Accept" text="{i18n>btnApprove}" class="sapUiTinyMarginEnd" press=".onOpenDialog"/>
                                <Button id="btnReject" type="Reject" text="{i18n>btnReject}" press=".onOpenRejectDialog"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
                
            </Table>
        </f:content>
        
    </f:DynamicPage>
</mvc:View>