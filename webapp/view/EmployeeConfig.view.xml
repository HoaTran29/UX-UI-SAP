<mvc:View
    controllerName="com.app.zu26g13.app.controller.EmployeeConfig"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar">

    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>titleEmpConfig}" level="H1"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- bộ lọc tìm kiếm -->
        <f:header>
            <f:DynamicPageHeader>
                <fb:FilterBar search=".onSearch" showGoOnFB="false" showClearOnFB="false" showFilterConfiguration="false" useToolbar="false">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem groupName="G1" name="Pernr" label="{i18n>filterEmpId}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="filterPernr" placeholder="{i18n>phSelectEmpFilter}" showValueHelp="true" valueHelpOnly="true" change=".onSearch" valueHelpRequest=".onPernrInputValueHelpRequest"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem groupName="G1" name="Dept" label="{i18n>filterDept}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="filterDept" placeholder="{i18n>phSelectDeptFilter}" showValueHelp="true" valueHelpOnly="true" change=".onSearch" valueHelpRequest=".onDeptInputValueHelpRequest"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem groupName="G1" name="ClearBtn" label="{i18n>ttClearFilter}" visibleInFilterBar="true">
                            <fb:control>
                                <HBox alignItems="Center">
                                    <Button icon="sap-icon://clear-filter" tooltip="{i18n>ttClearFilter}" type="Transparent" press=".onClear"/>
                                </HBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <!-- bảng danh sách nhân viên -->
        <f:content>
            <Table id="employeeTable" items="{path: '/Employee'}" growing="true" growingThreshold="20">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>titleEmpList}" level="H2"/>
                        <ToolbarSpacer />
                        <Button text="{i18n>btnCreateEmp}" icon="sap-icon://add" type="Emphasized" press=".onOpenCreateDialog" />
                    </OverflowToolbar>
                </headerToolbar>
                
                <columns>
                    <Column><Text text="{i18n>colEmpId}" /></Column>
                    <Column><Text text="{i18n>colEmpName}" /></Column>
                    <Column><Text text="{i18n>colCardId}" /></Column>
                    <Column><Text text="{i18n>colDept}" /></Column>
                    <Column><Text text="{i18n>colRole}" /></Column>
                    <Column width="12rem" hAlign="Center"><Text text="{i18n>colAction}" /></Column>
                </columns>
                
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{Pernr}" />
                            <Text text="{Ename}" />
                            <Text text="{CardId}" />
                            <ObjectAttribute text="{DeptName}" />
                            <ObjectAttribute text="{RoleDesc}" />
                            
                            <!-- nút sửa xóa -->
                            <HBox alignItems="Center" justifyContent="Center">
                                <Button icon="sap-icon://edit" text="{i18n>btnEdit}" type="Transparent" press=".onOpenEditDialog" class="sapUiTinyMarginEnd"/>
                                <Button icon="sap-icon://delete" text="{i18n>btnDelete}" type="Reject" press=".onDeleteEmployee" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>