<mvc:View
    id="employeeConfigView"
    controllerName="com.app.zu26g13.app.controller.EmployeeConfig"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:sap.m="sap.m"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <f:DynamicPage id="dynamicPageId">
        
        <!-- PHẦN 1: TIÊU ĐỀ TRANG (SẼ GIỮ CỐ ĐỊNH HOẶC THU GỌN KHI CUỘN) -->
        <f:title>
            <f:DynamicPageTitle id="pageTitleId">
                <f:heading>
                    <Title id="mainTitleId" text="{i18n>titleEmpConfig}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- PHẦN 2: HEADER CHỨA BỘ LỌC (SẼ BỊ ẨN ĐI KHI CUỘN BẢNG XUỐNG DƯỚI) -->
        <f:header>
            <f:DynamicPageHeader id="dynamicPageHeaderId">
                
                <!-- Sử dụng FilterBar chuẩn SAP thay vì HBox/VBox thủ công -->
                <fb:FilterBar id="filterBar" 
                    search=".onSearch" 
                    showGoOnFB="false" 
                    showClearOnFB="false" 
                    showFilterConfiguration="false" 
                    useToolbar="false">
                    
                    <fb:filterGroupItems>
                        
                        <!-- Lọc theo Mã Nhân Viên -->
                        <fb:FilterGroupItem groupName="G1" name="Pernr" label="{i18n>filterEmpId}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="filterPernr"
                                    placeholder="{i18n>phSelectEmpFilter}"
                                    showValueHelp="true"
                                    valueHelpOnly="true"
                                    change=".onSearch"
                                    valueHelpRequest=".onPernrInputValueHelpRequest"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- Lọc theo Phòng Ban -->
                        <fb:FilterGroupItem groupName="G1" name="Dept" label="{i18n>filterDept}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="filterDept"
                                    placeholder="{i18n>phSelectDeptFilter}"
                                    showValueHelp="true"
                                    valueHelpOnly="true"
                                    change=".onSearch"
                                    valueHelpRequest=".onDeptInputValueHelpRequest"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- Nút Xóa Lọc Custom (Dạng Icon) hiển thị ngang hàng -->
                        <fb:FilterGroupItem groupName="G1" name="ClearBtn" label="{i18n>ttClearFilter}" visibleInFilterBar="true">
                            <fb:control>
                                <HBox alignItems="Center">
                                    <Button
                                        icon="sap-icon://clear-filter"
                                        tooltip="{i18n>ttClearFilter}"
                                        type="Transparent"
                                        press=".onClearFilters"/>
                                </HBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                    </fb:filterGroupItems>
                </fb:FilterBar>

            </f:DynamicPageHeader>
        </f:header>

        <!-- PHẦN 3: NỘI DUNG CHÍNH LÀ BẢNG NHÂN VIÊN -->
        <f:content>
            <Table id="employeeTable"
                   items="{path: '/Employee'}"
                   growing="true"
                   growingThreshold="20">
                   
                <headerToolbar>
                    <OverflowToolbar id="tableToolbarId">
                        <Title id="tableTitleId" text="{i18n>titleEmpList}" level="H2"/>
                        <ToolbarSpacer id="toolbarSpacerId" />
                        <Button id="btnCreateId"
                                text="{i18n>btnCreateEmp}" 
                                icon="sap-icon://add" 
                                type="Emphasized" 
                                press=".onOpenCreateDialog" />
                    </OverflowToolbar>
                </headerToolbar>
                
                <columns>
                    <Column id="colPernr"><Text id="txtColPernr" text="{i18n>colEmpId}" /></Column>
                    <Column id="colEname"><Text id="txtColEname" text="{i18n>colEmpName}" /></Column>
                    <Column id="colCardId"><Text id="txtColCardId" text="{i18n>colCardId}" /></Column>
                    <Column id="colDept"><Text id="txtColDept" text="{i18n>colDept}" /></Column>
                    <Column id="colRole"><Text id="txtColRole" text="{i18n>colRole}" /></Column>
                    <Column id="colAction" width="12rem" hAlign="Center">
                        <Text id="txtColAction" text="{i18n>colAction}" />
                    </Column>
                </columns>
                
                <items>
                    <ColumnListItem id="rowTemplateId" vAlign="Middle">
                        <cells>
                            <Text id="cellPernr" text="{Pernr}" />
                            <Text id="cellEname" text="{Ename}" />
                            <Text id="cellCardId" text="{CardId}" />
                            <ObjectAttribute id="cellDept" text="{DeptName}" />
                            <ObjectAttribute id="cellRole" text="{RoleDesc}" />
                            
                            <HBox id="actionBoxId" alignItems="Center" justifyContent="Center">
                                <Button id="btnEditRowId"
                                        icon="sap-icon://edit" 
                                        text="{i18n>btnEdit}"
                                        type="Transparent" 
                                        press=".onOpenEditDialog" />
                                        
                                <Button id="btnDeleteRowId"
                                        icon="sap-icon://delete" 
                                        text="{i18n>btnDelete}"
                                        type="Reject" 
                                        press=".onDeleteEmployee" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
                
            </Table>
        </f:content>
        
    </f:DynamicPage>
</mvc:View>