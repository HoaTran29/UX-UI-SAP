<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="employeeDialog" title="{i18n>dialogTitleEmpInfo}" contentWidth="450px">
        <content>
            <f:SimpleForm id="employeeFormId" editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label id="lblPernr" text="{i18n>lblPernrFull}" required="true" />
                    <Input id="inputPernr" maxLength="8" type="Number" placeholder="{i18n>phEnterPernr}" />

                    <Label id="lblEname" text="{i18n>lblEnameFull}" required="true" />
                    <Input id="inputEname" maxLength="40" placeholder="{i18n>phEnterName}" />

                    <Label id="lblCardId" text="{i18n>lblCardIdFull}" />
                    <Input id="inputCardId" maxLength="20" placeholder="{i18n>phEnterCardId}" />

                    <Label id="lblDept" text="{i18n>colDept}" required="true" />
    <Select id="selectDept" items="{path: '/Department'}">
        <core:Item id="deptItemFragTemplate" key="{DeptId}" text="{DeptName}" />
    </Select>

    <Label id="lblRole" text="{i18n>colRole}" required="true" />
    <Select id="selectRole" items="{path: '/Role'}">
    <   core:Item id="roleItemFragTemplate" key="{RoleId}" text="{RoleDesc}" />
    </Select>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button id="btnSaveDialogId" text="{i18n>btnSave}" type="Emphasized" press=".onSaveEmployee" />
        </beginButton>
        <endButton>
            <Button id="btnCancelDialogId" text="{i18n>btnCancel}" press=".onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>