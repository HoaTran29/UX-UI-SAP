<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    
    <!-- popup thêm/sửa thông tin nhân viên -->
    <Dialog id="employeeDialog" title="{i18n>dialogTitleEmpInfo}" contentWidth="450px">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    
                    <!-- mã nhân viên -->
                    <Label text="{i18n>lblPernrFull}" required="true" />
                    <Input id="inputPernr" maxLength="8" type="Number" placeholder="{i18n>phEnterPernr}" />

                    <!-- tên nhân viên -->
                    <Label text="{i18n>lblEnameFull}" required="true" />
                    <Input id="inputEname" maxLength="40" placeholder="{i18n>phEnterName}" />

                    <!-- mã thẻ quẹt -->
                    <Label text="{i18n>lblCardIdFull}" />
                    <Input id="inputCardId" maxLength="20" placeholder="{i18n>phEnterCardId}" />

                    <!-- chọn phòng ban -->
                    <Label text="{i18n>colDept}" required="true" />
                    <Select id="selectDept" items="{path: '/Department'}">
                        <core:Item key="{DeptId}" text="{DeptName}" />
                    </Select>

                    <!-- chọn chức vụ -->
                    <Label text="{i18n>colRole}" required="true" />
                    <Select id="selectRole" items="{path: '/Role'}">
                        <core:Item key="{RoleId}" text="{RoleDesc}" />
                    </Select>

                </f:content>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button text="{i18n>btnSave}" type="Emphasized" press=".onSaveEmployee" />
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press=".onCloseDialog" />
        </endButton>
    </Dialog>

</core:FragmentDefinition>