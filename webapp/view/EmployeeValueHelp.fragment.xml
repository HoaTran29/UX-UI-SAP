<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <ResponsivePopover
        id="empValueHelpDialog"
        title="{i18n>dialogTitleSelectEmp}"
        placement="Bottom"
        contentWidth="350px"
        contentHeight="400px">
        
        <endButton>
            <Button text="Close" press=".onEmployeeValueHelpCancel" />
        </endButton>
        
        <subHeader>
            <Toolbar>
                <SearchField placeholder="Search..." search=".onEmployeeValueHelpSearch" liveChange=".onEmployeeValueHelpSearch" width="100%" />
            </Toolbar>
        </subHeader>
        
        <content>
            <List
                id="empValueHelpList"
                items="{/Employee}"
                mode="SingleSelectMaster"
                selectionChange=".onEmployeeValueHelpConfirm"
                noDataText="{i18n>noDataEmp}">
                <StandardListItem
                    title="{Ename}"
                    description="{Pernr}"
                    info="{DeptId}"
                    type="Active" />
            </List>
        </content>
        
    </ResponsivePopover>
</core:FragmentDefinition>