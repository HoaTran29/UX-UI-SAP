<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <!-- Employee Value Help Responsive Popover Fragment -->
    <ResponsivePopover
        id="empValueHelpDialog"
        title="{i18n>dialogTitleSelectEmp}"
        placement="Bottom"
        contentWidth="350px"
        contentHeight="400px">
        
        <!-- Popover Footer Action Button -->
        <endButton>
            <Button text="{i18n>btnClose}" press=".onEmployeeValueHelpCancel" />
        </endButton>
        
        <!-- Search SubHeader Section -->
        <subHeader>
            <Toolbar>
                <SearchField placeholder="{i18n>phSearchSelectEmp}" search=".onEmployeeValueHelpSearch" liveChange=".onEmployeeValueHelpSearch" width="100%" />
            </Toolbar>
        </subHeader>
        
        <!-- Popover Content Area: Employee List Selection -->
        <content>
            <List
                id="empValueHelpList"
                items="{/Employee}"
                mode="SingleSelectMaster"
                selectionChange=".onEmployeeValueHelpConfirm"
                noDataText="{i18n>noDataEmp}">
                
                <!-- Employee Item Template -->
                <StandardListItem
                    title="{Ename}"
                    description="{Pernr}"
                    info="{DeptId}"
                    type="Active" />
            </List>
        </content>
        
    </ResponsivePopover>
</core:FragmentDefinition>