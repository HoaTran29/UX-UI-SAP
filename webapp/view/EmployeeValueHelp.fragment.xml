<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    
    <ResponsivePopover placement="Bottom" contentWidth="350px" contentHeight="400px" title="{i18n>dialogTitleSelectEmp}">
        
        <!-- thanh tìm kiếm -->
        <subHeader>
            <Toolbar>
                <SearchField placeholder="{i18n>phSearchSelectEmp}" search=".onEmployeeValueHelpSearch" liveChange=".onEmployeeValueHelpSearch" width="100%" />
            </Toolbar>
        </subHeader>
        
        <!-- danh sách nhân viên -->
        <content>
            <List id="empValueHelpList" items="{/Employee}" mode="SingleSelectMaster" selectionChange=".onEmployeeValueHelpConfirm" noDataText="{i18n>noDataEmp}">
                <StandardListItem title="{Ename}" description="{Pernr}" info="{DeptId}" type="Active" />
            </List>
        </content>
        
        <endButton>
            <Button text="{i18n>btnClose}" press=".onEmployeeValueHelpCancel" />
        </endButton>
        
    </ResponsivePopover>

</core:FragmentDefinition>