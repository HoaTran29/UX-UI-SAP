<mvc:View
    controllerName="com.app.zu26g13.app.controller.Holiday"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page id="pageHoliday" showHeader="false" class="holidayPage">
        <content>
            <VBox class="holidayWrapper">

                <HBox class="holidayHeader" alignItems="Center" justifyContent="SpaceBetween">
                    <VBox>
                        <Title text="Holiday Configuration" titleStyle="H2" class="holidayTitle"/>
                        <Text text="Maintain holidays used by the scheduling system"/>
                    </VBox>

                    <Button
                        icon="sap-icon://add"
                        text="Add Holiday"
                        type="Emphasized"
                        press="onOpenAddDialog"/>
                </HBox>

                <MessageStrip
                    text="Sundays are detected automatically; they do not need to be maintained as holidays."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>

                <Table
                    id="holidayTable"
                    items="{/Holiday}"
                    growing="true"
                    growingScrollToLoad="true"
                    class="holidayTable sapUiResponsiveMargin"
                    width="auto">

                    <columns>
                        <Column width="180px">
                            <Text text="Holiday Date"/>
                        </Column>

                        <Column>
                            <Text text="Description"/>
                        </Column>

                        <Column width="140px" hAlign="Center">
                            <Text text="Actions"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>

                                <Text text="{path: 'HolDate', formatter: '.formatDate'}"/>

                                <Text text="{HolDesc}"/>

                                <HBox justifyContent="Center">
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="Edit holiday"
                                        press="onEditHoliday"
                                        class="sapUiTinyMarginEnd"/>

                                    <Button
                                        icon="sap-icon://delete"
                                        type="Reject"
                                        tooltip="Delete holiday"
                                        press="onDeleteHoliday"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>