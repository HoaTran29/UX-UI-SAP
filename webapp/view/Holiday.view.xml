<mvc:View
    controllerName="com.app.zu26g13.app.controller.Holiday"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    displayBlock="true">

    <!-- Fiori 3 Dynamic Page Layout for Holiday Configuration -->
    <f:DynamicPage id="dynamicPageHoliday" class="sapUiContentPadding">
        
        <!-- Header Section: Title and Actions -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>titleHolidayConfig}" level="H1"/>
                </f:heading>
                
                <f:actions>
                    <Button
                        id="btnAddHoliday"
                        icon="sap-icon://add"
                        text="{i18n>btnAddHoliday}"
                        type="Emphasized"
                        press="onOpenAddDialog"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Header Content: Information Message Strip -->
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <MessageStrip
                    text="{i18n>msgSundayAutoDetect}"
                    type="Information"
                    showIcon="true"/>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Main Content: Holiday Configuration Table -->
        <f:content>
            <Table
                id="holidayTable"
                items="{/Holiday}"
                growing="true"
                growingScrollToLoad="true"
                class="sapUiElevationCore3">

                <!-- Table Columns Definition -->
                <columns>
                    <Column width="180px">
                        <Text text="{i18n>colHolidayDate}"/>
                    </Column>

                    <Column>
                        <Text text="{i18n>colHolidayDesc}"/>
                    </Column>

                    <Column width="140px" hAlign="Center">
                        <Text text="{i18n>colAction}"/>
                    </Column>
                </columns>

                <!-- Table Rows Binding Template -->
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <!-- Holiday Date Cell -->
                            <Text text="{path: 'HolDate', formatter: '.formatDate'}"/>

                            <!-- Holiday Description Cell -->
                            <Text text="{HolDesc}"/>

                            <!-- Row Action Buttons: Edit & Delete -->
                            <HBox justifyContent="Center">
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="{i18n>ttEditHoliday}"
                                    press="onEditHoliday"
                                    class="sapUiTinyMarginEnd"/>

                                <Button
                                    icon="sap-icon://delete"
                                    type="Reject"
                                    tooltip="{i18n>ttDeleteHoliday}"
                                    press="onDeleteHoliday"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
        
    </f:DynamicPage>
</mvc:View>