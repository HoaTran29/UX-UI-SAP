<mvc:View
    controllerName="com.app.zu26g13.app.controller.Holiday"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    displayBlock="true">

    <f:DynamicPage class="sapUiContentPadding">
        
        <!-- header: tiêu đề và nút thêm -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>titleHolidayConfig}" level="H1"/>
                </f:heading>
                <f:actions>
                    <Button icon="sap-icon://add" text="{i18n>btnAddHoliday}" type="Emphasized" press="onOpenAddDialog"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <MessageStrip text="{i18n>msgSundayAutoDetect}" type="Information" showIcon="true"/>
            </f:DynamicPageHeader>
        </f:header>

        <!-- nội dung: bảng danh sách ngày lễ -->
        <f:content>
            <Table id="holidayTable" items="{/Holiday}" growing="true" growingScrollToLoad="true" class="sapUiElevationCore3">
                <columns>
                    <Column width="180px"><Text text="{i18n>colHolidayDate}"/></Column>
                    <Column><Text text="{i18n>colHolidayDesc}"/></Column>
                    <Column width="150px" hAlign="Center"><Text text="{i18n>colHolPayRate}"/></Column>
                    <Column width="140px" hAlign="Center"><Text text="{i18n>colAction}"/></Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{path: 'HolDate', formatter: '.formatDate'}"/>
                            <Text text="{HolDesc}"/>
                            <HBox alignItems="Center" justifyContent="Center">
                                <ObjectStatus text="{HolPayCode}" state="Information" class="sapUiTinyMarginEnd"/>
                                <ObjectNumber number="x{HolRateFactor}" />
                            </HBox>
                            
                            <!-- nút thao tác -->
                            <HBox justifyContent="Center">
                                <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>ttEditHoliday}" press="onEditHoliday" class="sapUiTinyMarginEnd"/>
                                <Button icon="sap-icon://delete" type="Reject" tooltip="{i18n>ttDeleteHoliday}" press="onDeleteHoliday"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
        
    </f:DynamicPage>
</mvc:View>