<mvc:View
    controllerName="com.app.zu26g13.app.controller.Holiday"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page id="pageHoliday" showHeader="false" class="holidayPage">
        <content>
            <VBox class="holidayWrapper">

                <HBox class="holidayHeader" alignItems="Center" justifyContent="SpaceBetween">
                    <VBox>
                        <Title text="{i18n>titleHolidayConfig}" titleStyle="H2" class="holidayTitle"/>
                        <Text text="{i18n>descHolidayConfig}"/>
                    </VBox>

                    <Button
                        icon="sap-icon://add"
                        text="{i18n>btnAddHoliday}"
                        type="Emphasized"
                        press="onOpenAddDialog"/>
                </HBox>

                <MessageStrip
                    text="{i18n>msgSundayAutoDetect}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>

                <Table
                    id="holidayTable"
                    items="{/Holiday}"
                    growing="true"
                    growingScrollToLoad="true"
                    class="holidayTable sapUiResponsiveMargin"
                    width="auto">

                    <columns>
                        <Column width="180px">
                            <Text text="{i18n>colHolidayDate}"/>
                        </Column>

                        <Column>
                            <Text text="{i18n>colHolidayDesc}"/>
                        </Column>

                        <Column width="140px" hAlign="Center">
                            <Text text="{i18n>colAction}"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>

                                <Text text="{path: 'HolDate', formatter: '.formatDate'}"/>

                                <Text text="{HolDesc}"/>

                                <HBox justifyContent="Center">
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="{i18n>ttEditHoliday}"
                                        press="onEditHoliday"
                                        class="sapUiTinyMarginEnd"/>

                                    <Button
                                        icon="sap-icon://delete"
                                        type="Reject"
                                        tooltip="{i18n>ttDeleteHoliday}"
                                        press="onDeleteHoliday"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>