<mvc:View controllerName="com.app.zu26g13.app.controller.MonthlyReport"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar">
    
    <f:DynamicPage id="dynamicPageMonthlyReport">
        
        <!-- PHẦN 1: Tiêu đề và nút Back -->
        <f:title>
            <f:DynamicPageTitle id="pageTitleMonthly">
                <f:heading>
                    <Title text="{i18n>titleMonthlyReport}" level="H1"/>
                </f:heading>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" tooltip="{i18n>btnBack}"/>
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- PHẦN 2: Header chứa bộ lọc -->
        <f:header>
            <f:DynamicPageHeader id="headerMonthly">
                
                <!-- Ẩn hết nút mặc định để dùng nút Clear tự chế -->
                <fb:FilterBar id="monthlyFilter" 
                              search=".onSearch" 
                              showGoOnFB="false" 
                              showClearOnFB="false" 
                              showFilterConfiguration="false" 
                              useToolbar="false" 
                              class="sapUiBottomMargin">
                    <fb:filterGroupItems>
                        
                        <!-- Lọc Tháng/Năm -->
                        <fb:FilterGroupItem groupName="G1" name="Month" label="{i18n>filterMonthYear}" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker id="fltMonth" displayFormat="MM/yyyy" placeholder="{i18n>phSelectMonthYear}" change=".onSearch" />
                            </fb:control>
                        </fb:FilterGroupItem>
                        
                        <!-- Lọc Mã NV -->
                        <fb:FilterGroupItem groupName="G1" name="Pernr" label="{i18n>filterEmpId}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="fltEmp" placeholder="{i18n>phEnterEmpId}" showValueHelp="true" valueHelpRequest=".onEmployeeValueHelpRequest" change=".onSearch" valueHelpOnly="true"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- Nút Clear đúng theo ý mày -->
                        <fb:FilterGroupItem groupName="G1" name="ClearBtn" label="{i18n>ttClearFilter}" visibleInFilterBar="true">
                            <fb:control>
                                <HBox alignItems="Center">
                                    <Button
                                        icon="sap-icon://clear-filter"
                                        tooltip="{i18n>ttClearFilter}"
                                        type="Transparent"
                                        press=".onClear"/>
                                </HBox>                                        
                            </fb:control>
                        </fb:FilterGroupItem>

                    </fb:filterGroupItems>
                </fb:FilterBar>
                
            </f:DynamicPageHeader>
        </f:header>

        <!-- PHẦN 3: Bảng hiển thị (Tích hợp sẵn PHÂN TRANG growing=true) -->
        <f:content>
            <Table id="monthlyTable"
                   items="{ path: '/MonthlyTimesheet', sorter: { path: 'Pernr' } }"
                   growing="true" 
                   growingThreshold="20" 
                   class="sapUiElevationCore3">
                
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>titleMonthlyDetails}" level="H4"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://excel-attachment" text="{i18n>btnExportExcel}" type="Success" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="{i18n>colEmpId}" /></Column>
                    <Column><Text text="{i18n>colMonthYear}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colTotalStdHours}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colTotalActHours}" /></Column>
                    <Column hAlign="Center"><Text text="{i18n>colTotalOtHours}" /></Column>
                </columns>
                
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <ObjectIdentifier title="{Pernr}" text="{EmployeeName}"/>
                            <Text text="{MonthYear}" />
                            
                            <ObjectNumber number="{TotalStdHours}" unit="{i18n>unitHours}" />
                            <ObjectNumber number="{TotalActHours}" unit="{i18n>unitHours}" 
                                          state="{= parseFloat(${TotalActHours}) >= parseFloat(${TotalStdHours}) ? 'Success' : 'Error' }"/>
                            <ObjectNumber number="{TotalOtHours}" unit="{i18n>unitHours}" state="Warning"/>
                        </cells>
                    </ColumnListItem>
                </items>
                
            </Table>
        </f:content>
        
    </f:DynamicPage>
</mvc:View>