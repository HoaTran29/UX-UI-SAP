<mvc:View controllerName="com.app.zu26g13.app.controller.MonthlyReport"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar">
    
    <f:DynamicPage>
        <!-- tiêu đề báo cáo -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>titleMonthlyReport}" level="H1"/>
                </f:heading>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" tooltip="{i18n>btnBack}"/>
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- thanh công cụ tìm kiếm -->
        <f:header>
            <f:DynamicPageHeader>
                <fb:FilterBar search=".onSearch" showGoOnFB="false" showClearOnFB="false" showFilterConfiguration="false" useToolbar="false" class="sapUiBottomMargin">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem groupName="G1" name="Month" label="{i18n>filterMonthYear}" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker id="fltMonth" displayFormat="MM/yyyy" placeholder="{i18n>phSelectMonthYear}" change=".onSearch" />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem groupName="G1" name="Pernr" label="{i18n>filterEmpId}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="fltEmp" placeholder="{i18n>phEnterEmpId}" showValueHelp="true" valueHelpRequest=".onEmployeeValueHelpRequest" change=".onSearch" valueHelpOnly="true"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem groupName="G1" name="ClearBtn" label="{i18n>ttClearFilter}" visibleInFilterBar="true">
                            <fb:control>
                                <HBox alignItems="Center">
                                    <Button icon="sap-icon://clear-filter" tooltip="{i18n>ttClearFilter}" type="Transparent" press=".onClear"/>
                                </HBox>                                        
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <!-- bảng báo cáo tổng hợp -->
        <f:content>
            <Table id="monthlyTable" items="{ path: '/MonthlyTimesheet', sorter: { path: 'Pernr' } }" growing="true" growingThreshold="20" class="sapUiElevationCore3">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>titleMonthlyDetails}" level="H4"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://excel-attachment" text="{i18n>btnExportExcel}" type="Success" press=".onExportExcel"/>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column width="180px" mergeDuplicates="true"><Text text="{i18n>colEmpId}" /></Column>
                    <Column width="100px" hAlign="Center"><Text text="{i18n>colMonthYear}" /></Column>
                    <Column hAlign="End"><Text text="{i18n>colRegInfo}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colWeInfo}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colHolInfo}"/></Column>
                </columns>
                
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <ObjectIdentifier title="{EmployeeName}" text="{Pernr}"/>
                            <Text text="{MonthYear}" />
                            
                            <!-- cột 1: ngày thường -->
                            <VBox alignItems="End" class="sapUiTinyMarginTopBottom">
                                <HBox><Text text="Số ca:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{RegularShiftCount}"/></HBox>
                                <HBox><Text text="Giờ làm:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{RegularPaidHours}" unit="h" state="Information"/></HBox>
                                <HBox><Text text="Giờ OT:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{RegularOtHours}" unit="h" state="Warning"/></HBox>
                                <HBox><Text text="Hệ số:" class="sapUiTinyMarginEnd"/><Text text="x{RegularRate} | OT: x{RegularOtRate}"/></HBox>
                            </VBox>

                            <!-- cột 2: cuối tuần -->
                            <VBox alignItems="End" class="sapUiTinyMarginTopBottom">
                                <HBox><Text text="Số ca:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{WeekendShiftCount}"/></HBox>
                                <HBox><Text text="Giờ làm:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{WeekendPaidHours}" unit="h" state="Information"/></HBox>
                                <HBox><Text text="Giờ OT:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{WeekendOtHours}" unit="h" state="Warning"/></HBox>
                                <HBox><Text text="Hệ số:" class="sapUiTinyMarginEnd"/><Text text="x{WeekendRate}"/></HBox>
                            </VBox>

                            <!-- cột 3: ngày lễ -->
                            <VBox alignItems="End" class="sapUiTinyMarginTopBottom">
                                <HBox><Text text="Số ca:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{HolidayShiftCount}"/></HBox>
                                <HBox><Text text="Giờ làm:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{HolidayPaidHours}" unit="h" state="Information"/></HBox>
                                <HBox><Text text="Giờ OT:" class="sapUiTinyMarginEnd"/><ObjectNumber number="{HolidayOtHours}" unit="h" state="Warning"/></HBox>
                                <HBox><Text text="Hệ số:" class="sapUiTinyMarginEnd"/><Text text="x{HolidayRate}"/></HBox>
                            </VBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>