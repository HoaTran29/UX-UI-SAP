<mvc:View controllerName="com.app.zu26g13.app.controller.PayTypeConfig"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar">
    
    <f:DynamicPage id="pagePayType">
        <!-- HEADER: Page Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>titlePayRateConfig}" level="H1"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- CONTENT: Data Table -->
        <f:content>
            <Table id="payTypeTable"
                   items="{ path: '/PayTypeConfig', sorter: { path: 'PayCode' } }"
                   growing="true" 
                   growingThreshold="20" 
                   class="sapUiElevationCore3">
                
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>titlePayRateList}" level="H4"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" text="{i18n>btnCreatePayRate}" type="Emphasized" press=".onCreatePress"/>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column width="150px"><Text text="{i18n>colPayCode}" /></Column>
                    <Column><Text text="{i18n>colDescription}" /></Column>
                    <Column width="150px" hAlign="Center"><Text text="{i18n>colRateFactor}" /></Column>
                    <Column width="200px" hAlign="Center"><Text text="{i18n>colAction}" /></Column>
                </columns>
                
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <ObjectIdentifier title="{PayCode}"/>
                            <Text text="{PayDesc}" />
                            <ObjectNumber number="x{RateFactor}" />
                            <HBox justifyContent="End">
                                <Button icon="sap-icon://edit" text="{i18n>btnEdit}" type="Transparent" press=".onEditPress" class="sapUiTinyMarginEnd"/>
                                <Button icon="sap-icon://delete" text="{i18n>btnDelete}" type="Reject" press=".onDeletePress"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>