<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="dlgPayType" title="{localModel>/title}" contentWidth="400px">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
            <f:content>
                <!-- Reuse existing labels from i18n -->
                <Label text="{i18n>lblPayCode}" required="true"/>
                <Input value="{localModel>/PayCode}" editable="{localModel>/isNew}" maxLength="4"/>
                
                <Label text="{i18n>lblCategory}" required="true"/>
                <Input value="{localModel>/PayCategory}" maxLength="2"/>
                
                <!-- Bind new i18n texts -->
                <Label text="{i18n>lblRateFactor}"/>
                <Input value="{localModel>/RateFactor}" type="Number"/>
                
                <Label text="{i18n>lblDescription}"/>
                <Input value="{localModel>/PayDesc}"/>
                
                <Label text="{i18n>lblNightShiftFlag}"/>
                <Select selectedKey="{localModel>/IsNight}">
                    <core:Item key=" " text="{i18n>txtNoNormal}"/>
                    <core:Item key="X" text="{i18n>txtYesNight}"/>
                </Select>
                
                <Label text="{i18n>lblDayType}"/>
                <Select selectedKey="{localModel>/DayType}">
                    <core:Item key="N" text="{i18n>txtDayNormal}"/>
                    <core:Item key="W" text="{i18n>txtDayWeekend}"/>
                    <core:Item key="H" text="{i18n>txtDayHoliday}"/>
                </Select>
            </f:content>
        </f:SimpleForm>
        <beginButton>
            <!-- Reuse existing btnSave -->
            <Button text="{i18n>btnSave}" type="Emphasized" press=".onSaveDialog"/>
        </beginButton>
        <endButton>
            <!-- Reuse existing btnCancel -->
            <Button text="{i18n>btnCancel}" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>