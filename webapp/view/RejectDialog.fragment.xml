<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
    
    <!-- Dispute Report Rejection Dialog Fragment -->
    <Dialog id="rejectDialog" title="{i18n>dialogTitleReject}" contentWidth="400px">
        
        <!-- Dialog Content Area -->
        <content>
            <layout:VerticalLayout class="sapUiContentPadding" width="100%">
                
                <!-- Rejection Reason Label -->
                <Label text="{i18n>lblRejectReason}" design="Bold" required="true"/>
                
                <!-- Rejection Reason Text Area Input -->
                <TextArea id="rejectReasonInput" value="{ApproverComment}" width="100%" rows="4" placeholder="{i18n>phRejectReason}" maxLength="255"/>
            
            </layout:VerticalLayout>
        </content>
        
        <!-- Dialog Action Buttons: Confirm Rejection & Cancel -->
        <beginButton>
            <Button type="Reject" text="{i18n>btnConfirmReject}" press=".onConfirmReject" />
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press=".onCancelReject" />
        </endButton>
        
    </Dialog>
</core:FragmentDefinition>