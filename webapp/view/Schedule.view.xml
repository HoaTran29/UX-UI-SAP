<mvc:View 
    controllerName="com.app.zu26g13.app.controller.Schedule"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    displayBlock="true">

    <Page title="{i18n>titleScheduleOt}">

        <!-- thanh công cụ tìm kiếm trên header -->
        <headerContent>
            <!-- tìm nhân viên -->
            <Input id="HeaderEmployeeSearchInput" value="{headerSearchModel>/employeeQuery}" placeholder="{i18n>phSearchSelectEmp}" width="260px" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onHeaderEmployeeValueHelpRequest" liveChange=".onHeaderEmployeeLiveChange" submit=".onHeaderEmployeeSubmit" class="sapUiSmallMarginEnd"/>

            <!-- tìm phòng ban -->
            <Input id="HeaderDepartmentSearchInput" value="{headerSearchModel>/deptQuery}" placeholder="{i18n>phSearchSelectDept}" width="260px" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onHeaderDepartmentValueHelpRequest" liveChange=".onHeaderDepartmentLiveChange" submit=".onHeaderDepartmentSubmit" class="sapUiSmallMarginEnd"/>

            <!-- xóa tìm kiếm -->
            <Button icon="sap-icon://clear-filter" type="Transparent" tooltip="{i18n>ttClearFilter}" press=".onClearHeaderFilters" class="sapUiSmallMarginEnd"/>

            <!-- tạo lịch mới -->
            <Button icon="sap-icon://add" text="{i18n>btnAddSchedule}" type="Emphasized" press="onOpenCreateDialog"/>
        </headerContent>

        <!-- phần lịch xếp ca (planning calendar) -->
        <content>
            <PlanningCalendar id="idPlanningCalendar" viewKey="Week" rows="{calendarModel>/employees}" appointmentSelect=".onAppointmentSelect">

                <rows>
                    <!-- thông tin nhân sự bên trái -->
                    <PlanningCalendarRow title="{calendarModel>EmployeeName} ({calendarModel>Pernr})" text="{= ${calendarModel>DeptName} ? ${calendarModel>DeptName} + ' - ' + ${calendarModel>DeptId} : ${calendarModel>DeptId} }" appointments="{ path: 'calendarModel>appointments', templateShareable: false }">

                        <!-- lịch làm việc (appointment) -->
                        <appointments>
                            <unified:CalendarAppointment 
                                startDate="{calendarModel>StartDate}"
                                endDate="{calendarModel>EndDate}"
                                title="{calendarModel>AppointmentTitle}"
                                text="{calendarModel>AppointmentText}"
                                tooltip="{calendarModel>AppointmentTooltip}"
                                type="{ parts: [ {path: 'calendarModel>ShiftId'}, {path: 'calendarModel>OtHours'} ], formatter: '.formatAppointmentType' }"/>
                        </appointments>

                    </PlanningCalendarRow>
                </rows>

            </PlanningCalendar>
        </content>
    </Page>
</mvc:View>