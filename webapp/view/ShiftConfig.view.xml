<mvc:View
    controllerName="com.app.zu26g13.app.controller.ShiftConfig"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="pageShiftConfig" showHeader="false" class="shiftConfigPage">
        <content>
            <VBox class="shiftConfigWrapper">

                <HBox class="shiftConfigHeader" alignItems="Center" justifyContent="SpaceBetween">
                    <VBox>
                        <Title text="Shift Configuration" titleStyle="H2" class="shiftConfigTitle"/>
                        <Text text="Maintain start time, end time, overnight flag, and allowed late minutes"/>
                    </VBox>

                    <Button
                        icon="sap-icon://add"
                        text="Add Shift"
                        type="Emphasized"
                        press="onOpenAddDialog"/>
                </HBox>

                <Table
                    id="shiftTable"
                    items="{/Schedule}"
                    growing="true"
                    growingScrollToLoad="true"
                    class="shiftConfigTable sapUiResponsiveMargin"
                    width="auto">

                    <columns>
                        <Column width="130px">
                            <Text text="Shift ID"/>
                        </Column>

                        <Column width="120px" hAlign="End">
                            <Text text="Standard Hours"/>
                        </Column>

                        <Column width="150px">
                            <Text text="Start Time"/>
                        </Column>

                        <Column width="150px">
                            <Text text="End Time"/>
                        </Column>

                        <Column width="130px" hAlign="Center">
                            <Text text="Overnight"/>
                        </Column>

                        <Column width="130px" hAlign="End">
                            <Text text="Grace mins"/>
                        </Column>

                        <Column width="140px" hAlign="Center">
                            <Text text="Actions"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <ObjectIdentifier
                                    title="{ShiftId}"
                                    text="Work Shift"/>

                                <ObjectNumber
                                    number="{StdHours}"
                                    unit="h"/>

                                <Text text="{path: 'TimeIn', formatter: '.formatODataTime'}"/>

                                <Text text="{path: 'TimeOut', formatter: '.formatODataTime'}"/>

                                <ObjectStatus
                                    text="{path: 'NextDay', formatter: '.formatNextDayText'}"
                                    state="{path: 'NextDay', formatter: '.formatNextDayState'}"/>

                                <ObjectNumber
                                    number="{GraceMins}"
                                    unit="min"/>

                                <HBox justifyContent="Center">
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="Edit shift"
                                        press="onEditShift"
                                        class="sapUiTinyMarginEnd"/>

                                    <Button
                                        icon="sap-icon://delete"
                                        type="Reject"
                                        tooltip="Delete shift"
                                        press="onDeleteShift"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>