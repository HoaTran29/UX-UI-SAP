<mvc:View 
    controllerName="com.app.zu26g13.app.controller.ShiftConfig"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page showHeader="false" class="shiftConfigPage">
        <content>
            <VBox class="shiftConfigWrapper sapUiResponsiveMargin">

                <!-- tiêu đề trang và nút tạo mới -->
                <HBox class="shiftConfigHeader sapUiMediumMarginBottom" alignItems="Center" justifyContent="SpaceBetween">
                    <VBox>
                        <Title text="{i18n>titleShiftConfig}" titleStyle="H2" class="shiftConfigTitle"/>
                    </VBox>
                    <Button icon="sap-icon://add" text="{i18n>btnAddShift}" type="Emphasized" press="onOpenAddDialog"/>
                </HBox>

                <!-- bảng danh sách ca làm việc -->
                <Table id="shiftTable" items="{/Schedule}" growing="true" growingScrollToLoad="true" class="shiftConfigTable" width="auto">
                    <columns>
                        <Column width="130px"><Text text="{i18n>lblShiftId}"/></Column>
                        <Column width="140px" hAlign="Center"><Text text="{i18n>lblStdHours}"/></Column>
                        <Column width="150px" hAlign="Center"><Text text="{i18n>colStartTime}"/></Column>
                        <Column width="150px" hAlign="Center"><Text text="{i18n>colEndTime}"/></Column>
                        <Column width="100px" hAlign="Center"><Text text="{i18n>colStdRate}"/></Column>
                        <Column width="100px" hAlign="Center"><Text text="{i18n>colWeekendRate}"/></Column>
                        <Column width="100px" hAlign="Center"><Text text="{i18n>colOtRate}"/></Column>
                        <Column width="130px" hAlign="Center"><Text text="{i18n>colNextDay}"/></Column>
                        <Column width="130px" hAlign="End"><Text text="{i18n>colGraceMins}"/></Column>
                        <Column width="140px" hAlign="Center"><Text text="{i18n>colAction}"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <ObjectIdentifier title="{ShiftId}" text="{i18n>txtShift}"/>
                                <ObjectNumber number="{StdHours}" unit="{i18n>unitH}"/>
                                
                                <!-- giờ bắt đầu và kết thúc -->
                                <Text text="{path: 'TimeIn', formatter: '.formatODataTime'}" textAlign="Center"/>
                                <Text text="{path: 'TimeOut', formatter: '.formatODataTime'}" textAlign="Center"/>
                                
                                <Text text="x{StdRateFactor}" />
                                <Text text="x{WeekendRateFactor}" />
                                <Text text="x{OtRateFactor}" />
                                <ObjectStatus text="{path: 'NextDay', formatter: '.formatNextDayText'}" state="{path: 'NextDay', formatter: '.formatNextDayState'}"/>
                                <ObjectNumber number="{GraceMins}" unit="{i18n>unitMins}"/>

                                <!-- nút sửa, xóa -->
                                <HBox justifyContent="Center">
                                    <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>ttEditShift}" press="onEditShift" class="sapUiTinyMarginEnd"/>
                                    <Button icon="sap-icon://delete" type="Reject" tooltip="{i18n>ttDeleteShift}" press="onDeleteShift"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>